<?xml version="1.0" encoding="utf-8"?>
<!--
    The restart shortcut's own icon: the power symbol, in the same green as the app's logo.

    Filled rather than stroked, because a launcher draws a shortcut icon at whatever size its own grid wants
    and a 2dp stroke scaled to 96dp is a shape nobody draws on purpose.

    The path is the standard 24dp power glyph: the bar across the top, then the ring, whose gap the bar sits
    in. It parses as 2 subpaths - the bar as a rectangle, the ring as one closed curve - and both stay inside
    the viewport.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

